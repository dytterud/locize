# Ignore specific files
.settings.xml
.monitor
.DS_Store
*.orig
npm-debug.log
npm-debug.log.*
*.dat

# Ignore various temporary files
*~
*.swp


# Ignore various Node.js related directories and files
node_modules
node_modules/**/*
coverage/**/*
dist/**/*

# Secrets & credentials
.env
.env.*
!.env.example
*.pem
*.key

# Local Claude Code context (not for the public repo)
CLAUDE.md
CLAUDE.local.md

# Lockfiles are not committed: this is a library, consumers resolve their own
# tree, and the debuggingApps lockfiles only produced dependabot noise for demo
# code that is never published.
package-lock.json
